# QBIT Connect backend — local development environment
# Copy to .env and edit. NEVER commit the real .env.
# Docker deployment uses the .env.example at the repository root instead.

# --- Core (required) ---
QBIT_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QBIT_SECRET_KEY=dev-only-insecure-secret-key-change-me

# --- Database ---
# Development fallback (SQLite). Production REQUIRES PostgreSQL:
#   postgresql+asyncpg://USER:PASSWORD@localhost:5432/qbit
DATABASE_URL=sqlite+aiosqlite:///./qbit-dev.db

# --- Redis (optional; app is fully functional without it) ---
# REDIS_URL=redis://:password@localhost:6379/0

# --- Storage directories (defaults shown; created on startup) ---
QBIT_DATA_DIR=./qbit-data
# QBIT_EXPORT_DIR=./qbit-data/exports
# QBIT_LOG_DIR=./qbit-data/logs
# QBIT_BACKUP_DIR=./qbit-data/backups

# --- First-run bootstrap (used by `python -m app.cli seed`) ---
# QBIT_ADMIN_EMAIL=admin@example.com
# QBIT_ADMIN_PASSWORD=

# --- Optional tuning ---
# QBIT_CORS_ORIGINS=http://localhost:8000
# QBIT_LOG_LEVEL=INFO
# QBIT_SESSION_TTL_MINUTES=480
# QBIT_MAX_UPLOAD_MB=100
# QBIT_RATE_LIMIT_LOGIN_PER_MIN=10

# --- Scraping engine (Phase 3) ---
QBIT_SCRAPER_DISABLED_ACTORS=
QBIT_SCRAPER_JOB_TIMEOUT_SECONDS=3600
QBIT_SCRAPER_REQUEST_TIMEOUT_SECONDS=20
QBIT_SCRAPER_ALLOW_PRIVATE_TARGETS=false
QBIT_WORKER_LEASE_SECONDS=120
QBIT_WORKER_MAX_CONCURRENT_JOBS=2
# google-maps actor provider (none = DEGRADED; mock = tests/dev only)
QBIT_MAPS_PROVIDER=none
# QBIT_MAPS_PROVIDER_URL=https://your-provider.example.com/v1/search
# QBIT_MAPS_PROVIDER_API_KEY=

# --- Marketing engine (Phase 5) ---
# QBIT_MARKETING_ALLOW_MOCK_PROVIDER=false  (tests only; forbidden in production)
# QBIT_MARKETING_RATE_PER_MINUTE=10
# QBIT_MARKETING_RATE_PER_HOUR=100

# --- WhatsApp Business provider (Phase 6) ---
# Official WhatsApp Business Cloud API only. Credentials per sending account
# are stored ENCRYPTED in the database vault (Connections UI); the env values
# below are app-level defaults / single-account bootstrap fallbacks.
WHATSAPP_PROVIDER=whatsapp_cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# Webhook subscription handshake token (required in production):
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 webhook signatures:
# WHATSAPP_APP_SECRET=
# Single-account bootstrap fallbacks (vault credentials always take precedence):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# Webhook hardening:
QBIT_WEBHOOK_MAX_AGE_SECONDS=600
QBIT_WEBHOOK_MAX_BODY_BYTES=1048576
