# QBIT Connect backend — local development environment
# Copy to .env and edit. NEVER commit the real .env.
# Docker deployment uses the .env.example at the repository root instead.

# --- Core (required) ---
QBIT_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QBIT_SECRET_KEY=dev-only-insecure-secret-key-change-me

# --- Database ---
# Development fallback (SQLite). Production REQUIRES PostgreSQL:
#   postgresql+asyncpg://USER:PASSWORD@localhost:5432/qbit
DATABASE_URL=sqlite+aiosqlite:///./qbit-dev.db

# --- Redis (optional; app is fully functional without it) ---
# REDIS_URL=redis://:password@localhost:6379/0

# --- Storage directories (defaults shown; created on startup) ---
QBIT_DATA_DIR=./qbit-data
# QBIT_EXPORT_DIR=./qbit-data/exports
# QBIT_LOG_DIR=./qbit-data/logs
# QBIT_BACKUP_DIR=./qbit-data/backups

# --- First-run bootstrap (used by `python -m app.cli seed`) ---
# QBIT_ADMIN_EMAIL=admin@example.com
# QBIT_ADMIN_PASSWORD=

# --- Optional tuning ---
# QBIT_CORS_ORIGINS=http://localhost:8000
# QBIT_LOG_LEVEL=INFO
# QBIT_SESSION_TTL_MINUTES=480
# QBIT_MAX_UPLOAD_MB=100
# QBIT_RATE_LIMIT_LOGIN_PER_MIN=10

# --- Phase 11: team / admin / enterprise ------------------------------------
# Invitation links expire after this many hours (1-720)
# QBIT_INVITATION_EXPIRY_HOURS=168
# Abuse protection: invitations / API key creations per user per hour
# QBIT_RATE_LIMIT_INVITE_PER_HOUR=30
# QBIT_RATE_LIMIT_APIKEY_PER_HOUR=10

# --- Scraping engine (Phase 3) ---
QBIT_SCRAPER_DISABLED_ACTORS=
QBIT_SCRAPER_JOB_TIMEOUT_SECONDS=3600
QBIT_SCRAPER_REQUEST_TIMEOUT_SECONDS=20
QBIT_SCRAPER_ALLOW_PRIVATE_TARGETS=false
QBIT_WORKER_LEASE_SECONDS=120
QBIT_WORKER_MAX_CONCURRENT_JOBS=2
# google-maps actor provider (none = DEGRADED; mock = tests/dev only)
QBIT_MAPS_PROVIDER=none
# QBIT_MAPS_PROVIDER_URL=https://your-provider.example.com/v1/search
# QBIT_MAPS_PROVIDER_API_KEY=

# --- Marketing engine (Phase 5) ---
# QBIT_MARKETING_ALLOW_MOCK_PROVIDER=false  (tests only; forbidden in production)
# QBIT_MARKETING_RATE_PER_MINUTE=10
# QBIT_MARKETING_RATE_PER_HOUR=100

# --- WhatsApp Business provider (Phase 6) ---
# Official WhatsApp Business Cloud API only. Credentials per sending account
# are stored ENCRYPTED in the database vault (Connections UI); the env values
# below are app-level defaults / single-account bootstrap fallbacks.
WHATSAPP_PROVIDER=whatsapp_cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# Webhook subscription handshake token (required in production):
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 webhook signatures:
# WHATSAPP_APP_SECRET=
# Single-account bootstrap fallbacks (vault credentials always take precedence):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Email marketing provider (Phase 7) ---
# Real, provider-supported email delivery: SMTP (TLS/STARTTLS) or a generic
# transactional Email API. Per-sender credentials live ENCRYPTED in the vault
# (Connections UI); the env values below are single-account bootstrap
# fallbacks only. NEVER commit real credentials.
EMAIL_PROVIDER=smtp
# SMTP (Phase 7 §4):
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_USERNAME=marketing@company.com
# SMTP_PASSWORD=
# TLS | STARTTLS | NONE (NONE is strongly discouraged)
SMTP_SECURITY=STARTTLS
# Generic Email API (Phase 7 §5):
# EMAIL_API_BASE_URL=https://email-api.company.com/v1
# EMAIL_API_KEY=
# EMAIL_API_ACCOUNT_ID=
# EMAIL_API_REGION=
# Shared secret for email webhook signature validation (Phase 7 §28):
# EMAIL_WEBHOOK_SECRET=
# Public base URL used to build REAL unsubscribe links. Required before any
# EMAIL campaign can launch — fake unsubscribe links are never generated:
# QBIT_EMAIL_UNSUBSCRIBE_BASE_URL=https://qbit.company.com
# Campaign-level tracking defaults (per-campaign opt-in overrides these):
QBIT_EMAIL_DEFAULT_TRACK_OPENS=false
QBIT_EMAIL_DEFAULT_TRACK_CLICKS=false
QBIT_EMAIL_APPEND_UNSUBSCRIBE_FOOTER=true
# Sender-reputation warning thresholds (monitoring only — no placement claims):
QBIT_EMAIL_BOUNCE_WARN_RATE=0.05
QBIT_EMAIL_COMPLAINT_WARN_RATE=0.005

# Webhook hardening (WhatsApp + Email):
QBIT_WEBHOOK_MAX_AGE_SECONDS=600
QBIT_WEBHOOK_MAX_BODY_BYTES=1048576

# --- Workflow automation engine (Phase 9) ---
# Graph + runtime caps (§42): prevent runaway definitions/executions
QBIT_AUTOMATION_MAX_NODES=50
QBIT_AUTOMATION_MAX_STEPS_PER_EXECUTION=100
# Transient-error retry policy (§38): exponential backoff between bounds
QBIT_AUTOMATION_MAX_RETRIES=3
QBIT_AUTOMATION_RETRY_BASE_SECONDS=30
QBIT_AUTOMATION_RETRY_MAX_SECONDS=3600
# Loop protection (§40): per-(workflow, entity) window limit + causation depth
QBIT_AUTOMATION_MAX_EXECUTIONS_PER_WINDOW=10
QBIT_AUTOMATION_WINDOW_MINUTES=60
QBIT_AUTOMATION_MAX_CAUSATION_DEPTH=2
# Worker claim tuning (§58-§59)
QBIT_AUTOMATION_LEASE_SECONDS=300
QBIT_AUTOMATION_BATCH_SIZE=10
QBIT_AUTOMATION_MAX_WAIT_HOURS=720
# Reserved-capability gates (§24, §54) — honest defaults:
# no team directory exists yet; campaign launch goes through the validated path
QBIT_AUTOMATION_ENABLE_TEAM_ASSIGN=false
QBIT_AUTOMATION_ENABLE_START_CAMPAIGN=true

# --- Analytics & reporting engine (Phase 10) -------------------------------
# Redis-backed dashboard cache TTL (5-3600s); direct queries when REDIS_URL unset
QBIT_ANALYTICS_CACHE_TTL_SECONDS=60
# Daily aggregate refresh cadence (seconds, min 300) + master switch
QBIT_ANALYTICS_AGGREGATION_INTERVAL_SECONDS=3600
QBIT_ANALYTICS_AGGREGATION_ENABLED=true
# Rows above which a report snapshot spills to a StorageService export file
QBIT_ANALYTICS_MAX_SNAPSHOT_ROWS=10000
