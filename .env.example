# QBIT runtime env for docker compose (copy to .env at repo root and edit)
# NEVER commit the real .env.

QBIT_ENV=production
QBIT_SECRET_KEY=change-me-long-random

POSTGRES_DB=qbit
POSTGRES_USER=qbit
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

QBIT_DATA_HOST_PATH=./qbit-data
QBIT_API_PORT=8000
QBIT_CORS_ORIGINS=
QBIT_LOG_LEVEL=INFO
