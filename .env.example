# QBIT runtime env for docker compose (copy to .env at repo root and edit)
# NEVER commit the real .env.

QBIT_ENV=production
QBIT_SECRET_KEY=change-me-long-random

POSTGRES_DB=qbit
POSTGRES_USER=qbit
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

QBIT_DATA_HOST_PATH=./qbit-data
QBIT_API_PORT=8000
QBIT_CORS_ORIGINS=
QBIT_LOG_LEVEL=INFO

# --- Scraping engine (Phase 3) ---
# Comma-separated actor ids to disable (google-maps, website, email-finder,
# business-directory, public-data, universal-web)
QBIT_SCRAPER_DISABLED_ACTORS=
QBIT_SCRAPER_JOB_TIMEOUT_SECONDS=3600
QBIT_SCRAPER_REQUEST_TIMEOUT_SECONDS=20
QBIT_SCRAPER_MAX_RESPONSE_MB=5
QBIT_SCRAPER_RPS_PER_HOST=1.0
QBIT_SCRAPER_CONCURRENCY=4
QBIT_SCRAPER_MAX_RETRIES=3
QBIT_SCRAPER_BATCH_SIZE=100
QBIT_SCRAPER_ALLOW_PRIVATE_TARGETS=false
QBIT_SCRAPER_ALLOWED_PORTS=80,443
QBIT_WORKER_LEASE_SECONDS=120
QBIT_WORKER_MAX_CONCURRENT_JOBS=2

# --- Maps provider (google-maps actor; none = actor DEGRADED) ---
# none | http (a compliant, licensed data endpoint you configure)
QBIT_MAPS_PROVIDER=none
# QBIT_MAPS_PROVIDER_URL=https://your-provider.example.com/v1/search
# API keys: never in compose/env files committed to git; use a secrets manager
# QBIT_MAPS_PROVIDER_API_KEY=
